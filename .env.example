# Copia questo file in .env e valorizza le chiavi. NON committare .env.

# --- Gemini (API nativa: step 1 video, e step unico se scelto in UI) ---
GEMINI_API_KEY=

# --- OpenRouter (Claude/GPT: step 2 video, o step unico per formati non-video) ---
OPENROUTER_API_KEY=

# --- Azure AI Foundry (dormiente in v1, non esposto in UI) ---
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=
FOUNDRY_PAGES_PER_BATCH=10
FOUNDRY_RASTER_DPI=150

# --- Backend (v1: sqlite/password; v2: azure/easyauth) ---
STORAGE_BACKEND=sqlite
AUTH_PROVIDER=password

# --- Percorsi ---
# DATA_DIR=./data
# USERS_FILE=./users.yaml
# MODELS_FILE=./models.yaml

# --- Guardrail ---
MAX_UPLOAD_MB=500
MAX_PAGES=300
XLSX_MAX_ROWS_PER_SHEET=5000

# --- Worker ---
WORKER_POLL_SECONDS=1.0
RETRY_MAX_ATTEMPTS=2
RETRY_BACKOFF_SECONDS=5.0
